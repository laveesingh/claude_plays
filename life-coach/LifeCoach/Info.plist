<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── Core bundle keys (previously auto-generated by GENERATE_INFOPLIST_FILE) ── -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundlePackageType</key>
	<string>$(PACKAGE_TYPE)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- ── Keys that were previously generated from INFOPLIST_KEY_* build settings ── -->
	<key>CFBundleDisplayName</key>
	<string>Sapiod</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Your coach reads your calendar to plan your day around real commitments and, if you allow it, writes its time blocks as events.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Your coach reads workouts, steps, and sleep to verify your fitness commitments instead of trusting self-reports.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used to capture your voice when you speak to your coach instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Used to transcribe your speech to text on-device so you can talk to your coach.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- ── M5: background capabilities ── -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.laveesingh.LifeCoach.inbox.refresh</string>
	</array>
</dict>
</plist>
